# Copy to .env (git-ignored). See src/main.ts for every setting.

# --- Dev ---
# Use a Supabase project made just for development.
SUPABASE_URL=https://your-dev-project.supabase.co
# Leave DATABASE_URL unset in dev: an embedded PGlite database is used under .data/pglite.
WEB_ORIGINS=http://localhost:5173
PORT=8787
# Invitations are emailed through Resend. Without a key the link is logged and shown to the admin instead.
# RESEND_API_KEY=re_...
# MAIL_FROM=Ida <invites@your-domain.example>
# Where invite links point. Defaults to the first WEB_ORIGINS entry.
# WEB_APP_URL=http://localhost:5173

# --- Production (set these in the host's environment, not in a file) ---
# NODE_ENV=production
# SUPABASE_URL=https://your-prod-project.supabase.co
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# STREAM_SECRET=<a long random string>
# WEB_ORIGINS=https://your-web-app.example.com
# How many proxies / load balancers sit in front of the server (default 0). Set it, or the per-address limits on
# failed sign-ins all see the proxy's address instead of the client's.
# TRUST_PROXY=1
