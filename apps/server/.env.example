# Copy to .env (git-ignored). See src/main.ts for every setting.
SUPABASE_URL=https://your-project.supabase.co
# Leave DATABASE_URL unset to use the embedded PGlite database under .data/pglite.
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# STREAM_SECRET=<a long random string>   (required when NODE_ENV=production)
WEB_ORIGINS=http://localhost:5173
PORT=8787
