# Copy to .env (git-ignored). Create a project in the web app (http://localhost:5173), make an ingest key, paste it here.
IDA_PROJECT_KEY=ida_...
IDA_ENDPOINT=http://localhost:8787

# The attack simulator page the Node demo serves.
DEMO_PORT=5175

# The broker leg (Kafka + RabbitMQ) for the system view.
# npm run dev starts them (Docker) and turns this on; set DEMO_BROKERS=0 to skip them.
# DEMO_BROKERS=1
# KAFKA_BROKERS=localhost:9094
# AMQP_URL=amqp://guest:guest@localhost:5673
