# Copy to .env.local and fill in. The publishable key is meant for browsers; never put a secret key here.
# Dev: your development Supabase project and the local server.
# Prod: set these in the environment when running `npm run build`; they are baked into the static files.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_API_URL=http://localhost:8787
