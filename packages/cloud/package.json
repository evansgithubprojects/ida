{
  "name": "@ida-dev/cloud",
  "version": "0.1.0",
  "description": "Uploads event chain recordings to the Ida server, spooling locally while offline",
  "type": "module",
  "main": "./dist/node.cjs",
  "module": "./dist/browser.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@ida-dev/core": "^0.1.0"
  },
  "license": "MIT",
  "devDependencies": {
    "fake-indexeddb": "^6.2.6"
  }
}
