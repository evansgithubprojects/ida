{
  "name": "@ida-dev/adapter-amqplib",
  "version": "0.1.0",
  "description": "amqplib adapter for Ida: records published and consumed RabbitMQ messages and links them across services",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@ida-dev/core": "^0.1.0"
  },
  "peerDependencies": {
    "amqplib": ">=0.10.0"
  },
  "devDependencies": {
    "amqplib": "2.2.0"
  },
  "license": "MIT"
}
