# Copy to .env and fill in. Create a project in the Ida web app, then "Connect an app" shows its ingest key.
IDA_PROJECT_KEY=

# Where the services upload. The default reaches `npm run dev` on your machine from inside Docker.
# IDA_ENDPOINT=http://host.docker.internal:8787

# How often the storefront places an order, in milliseconds.
# ORDER_EVERY_MS=2000
